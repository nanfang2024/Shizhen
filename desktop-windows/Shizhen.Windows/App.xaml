<Application x:Class="Shizhen.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Shizhen.Windows.Core"
             xmlns:vm="clr-namespace:Shizhen.Windows.ViewModels"
             xmlns:views="clr-namespace:Shizhen.Windows.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <core:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <core:NullToVisibilityConverter x:Key="NullToVisibility" />
            <core:StringToVisibilityConverter x:Key="StringToVisibility" />
            <core:EnumToVisibilityConverter x:Key="EnumToVisibility" />
            <core:BooleanInverseConverter x:Key="BooleanInverse" />
            <core:RemoteImageConverter x:Key="RemoteImage" />
            <core:StatusBrushConverter x:Key="StatusBrush" />

            <DataTemplate DataType="{x:Type vm:ExtractorViewModel}">
                <views:ExtractorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConverterViewModel}">
                <views:ConverterView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                <views:HistoryView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
