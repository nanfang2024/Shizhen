<Window x:Class="Shizhen.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拾帧"
        Width="1280" Height="820" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/Shizhen.ico"
        AllowDrop="True"
        Drop="OnDrop">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="24,28,20,24">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource PrimaryBrush}">
                            <Viewbox Margin="10">
                                <Path Data="M2,3 L8,3 M2,3 L2,9 M14,3 L8,3 M14,3 L14,9 M2,13 L2,7 M2,13 L8,13 M14,13 L14,7 M14,13 L8,13 M5,8 L11,8"
                                      Stroke="{DynamicResource OnPrimaryBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="拾帧" FontSize="21" FontWeight="SemiBold" />
                            <TextBlock Text="Windows x64" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,4,0,0">
                    <RadioButton Style="{StaticResource NavigationButtonStyle}"
                                 IsChecked="{Binding IsExtractorSelected, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Extractor">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                <Path Data="M8.5,5.5 L11,3 A4,4 0 0 1 16.5,8.5 L14,11 M7.5,14.5 L5,17 A4,4 0 0 1 -0.5,11.5 L2,9 M6,11 L10,7"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                            <TextBlock Text="链接提取" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavigationButtonStyle}"
                                 IsChecked="{Binding IsConverterSelected, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Converter">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                <Path Data="M3,5 L14,5 M11,2 L14,5 L11,8 M14,13 L3,13 M6,10 L3,13 L6,16"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Viewbox>
                            <TextBlock Text="格式转换" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavigationButtonStyle}"
                                 IsChecked="{Binding IsHistorySelected, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="History">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                <Path Data="M3,4 L3,8 L7,8 M3.5,7.5 A7,7 0 1 0 5,3 M10,5 L10,10 L13,12"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Viewbox>
                            <TextBlock Text="历史记录" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="16,16,16,22">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ToggleThemeCommand}" MinWidth="0" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="0,0,10,0">
                                <Path Data="M8,1 A7,7 0 1 0 15,8 A5.5,5.5 0 0 1 8,1"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Fill="Transparent" />
                            </Viewbox>
                            <TextBlock Text="{Binding ThemeLabel}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
