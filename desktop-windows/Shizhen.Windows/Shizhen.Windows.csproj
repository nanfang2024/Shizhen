<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\Shizhen.ico</ApplicationIcon>
    <AssemblyName>Shizhen</AssemblyName>
    <RootNamespace>Shizhen.Windows</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>1.0.7</Version>
    <AssemblyTitle>拾帧</AssemblyTitle>
    <Product>拾帧 Windows</Product>
    <Description>公开媒体提取与本地格式转换工具</Description>
    <Authors>fuu-start</Authors>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.20" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Shizhen.ico" />
    <None Include="Tools\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('Tools')" />
  </ItemGroup>
</Project>
