<UserControl x:Class="Shizhen.Windows.Views.ConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Shizhen.Windows.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch" Padding="0,0,8,0">
        <Grid MaxWidth="1040" Margin="32,28,32,40" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="本地格式转换" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="文件只在本机处理，不会上传到服务器" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource NoticeCardStyle}" Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource PrimaryContainerBrush}">
                        <TextBlock Text="i" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="仅处理无需解密、无 DRM 且你有权保存的本地文件。" Foreground="{DynamicResource TextSecondaryBrush}" Margin="11,2,0,0" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,16,0,0"
                    Visibility="{Binding HasFile, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid MinHeight="180">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="60" Height="60" CornerRadius="18" Background="{DynamicResource PrimaryContainerBrush}">
                            <Viewbox Margin="16">
                                <Path Data="M1,5 L6,5 L8,7 L15,7 L15,14 L1,14 Z M5,2 L11,2 L11,7" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.4" Fill="Transparent" StrokeLineJoin="Round" />
                            </Viewbox>
                        </Border>
                        <TextBlock Text="尚未选择文件" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Text="支持 MP4、MKV、MOV、WebM、AVI 和 GIF" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                        <Button Content="选择本地媒体" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ChooseFileCommand}" Margin="0,16,0,0" MinWidth="160" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="60" Height="60" CornerRadius="14" Background="{DynamicResource PrimaryContainerBrush}" VerticalAlignment="Top">
                            <Viewbox Margin="16">
                                <Path Data="M2,2 L13,2 L13,14 L2,14 Z M6,6 L10,8 L6,10 Z" Stroke="{DynamicResource PrimaryBrush}" Fill="Transparent" StrokeThickness="1.4" StrokeLineJoin="Round" />
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding SelectedFile.FileName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0">
                                <Run Text="{Binding SelectedFile.TypeDisplay, Mode=OneWay}" /><Run Text=" · " />
                                <Run Text="{Binding SelectedFile.SizeDisplay, Mode=OneWay}" /><Run Text=" · " />
                                <Run Text="{Binding SelectedFile.ResolutionDisplay, Mode=OneWay}" /><Run Text=" · " />
                                <Run Text="{Binding SelectedFile.DurationDisplay, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding SelectedFile.Path}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="更换文件" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ChooseFileCommand}" Margin="16,0,0,0" />
                    </Grid>
                </Border>

                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="选择转换功能" Style="{StaticResource SectionTitleStyle}" />
                    <ListBox ItemsSource="{Binding AvailableOperations}" SelectedItem="{Binding SelectedOperation}" BorderThickness="0" Background="Transparent" Margin="0,10,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="16,12" />
                                <Setter Property="MinWidth" Value="230" />
                                <Setter Property="Margin" Value="0,0,10,10" />
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="OperationBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="OperationBorder" Property="Background" Value="{DynamicResource PrimaryContainerBrush}" />
                                                    <Setter TargetName="OperationBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OperationBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ConversionOption}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <Border Style="{StaticResource CardStyle}" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Text="转换参数" Style="{StaticResource SectionTitleStyle}" />

                        <Grid Margin="0,16,0,0" Visibility="{Binding SelectedMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=VideoToGif}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="开始时间（秒）" FontWeight="SemiBold" />
                                <TextBox Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0" AutomationProperties.Name="开始时间（秒）" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="结束时间（秒）" FontWeight="SemiBold" />
                                <TextBox Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0" AutomationProperties.Name="结束时间（秒）" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,16,0,0">
                                <TextBlock Text="帧率" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding Fps}" Margin="0,7,0,0" AutomationProperties.Name="输出帧率" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0">
                                <TextBlock Text="输出宽度" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding WidthOptions}" SelectedItem="{Binding SelectedWidth}" DisplayMemberPath="Label" Margin="0,7,0,0" AutomationProperties.Name="输出宽度" />
                            </StackPanel>
                            <CheckBox Grid.Row="2" Grid.Column="0" Content="循环播放" IsChecked="{Binding LoopGif}" Margin="0,14,0,0" />
                        </Grid>

                        <StackPanel Margin="0,16,0,0" Visibility="{Binding SelectedMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=GifToMp4}">
                            <TextBlock Text="转换为兼容大多数播放器和社交平台的 MP4 视频。" />
                            <Expander Header="技术详情" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0">
                                <TextBlock Text="使用 H.264 编码、yuv420p 像素格式和 faststart，保持原动画时间轴。" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0" />
                            </Expander>
                        </StackPanel>

                        <Grid Margin="0,16,0,0" Visibility="{Binding SelectedMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=ExtractFrames}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="每隔多少秒提取一张" FontWeight="SemiBold" />
                                <TextBox Text="{Binding IntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0" AutomationProperties.Name="提取间隔（秒）" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="图片格式" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding ImageFormats}" SelectedItem="{Binding ImageFormat}" Margin="0,7,0,0" AutomationProperties.Name="图片格式" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,16,0,0">
                                <TextBlock Text="文件名规则" FontWeight="SemiBold" />
                                <TextBox Text="{Binding FileNamePattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0" AutomationProperties.Name="输出文件名规则" />
                                <TextBlock Text="将自动追加五位序号，例如 frame_00001.jpg" Style="{StaticResource CaptionStyle}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,0" Visibility="{Binding SelectedMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=ExtractFrames, ConverterCulture=zh-CN}">
                            <TextBlock Text="{Binding EstimatedOutput}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />
                        </Grid>

                        <StackPanel Margin="0,16,0,0" Visibility="{Binding SelectedMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=VideoToGif}">
                            <TextBlock Text="输出文件名" FontWeight="SemiBold" />
                            <TextBox Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0" AutomationProperties.Name="输出文件名" />
                            <TextBlock Text="{Binding EstimatedOutput}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,7,0,0" />
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0" Visibility="{Binding SelectedMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=GifToMp4}">
                            <TextBlock Text="输出文件名" FontWeight="SemiBold" />
                            <TextBox Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0" AutomationProperties.Name="输出文件名" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="保存位置" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding OutputFolder}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="650" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="更改位置" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ChooseFolderCommand}" Margin="16,0,0,0" />
                    </Grid>
                </Border>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button Content="{Binding ActionLabel}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartCommand}" MinWidth="160" />
                    <Button Grid.Column="1" Content="重新选择" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ResetCommand}" Margin="10,0,0,0" />
                    <Button Grid.Column="3" Content="取消任务" Style="{StaticResource DangerButtonStyle}" Command="{Binding CancelCommand}" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="4">
                <Border Style="{StaticResource CardStyle}" Background="{DynamicResource SurfaceSecondaryBrush}" Margin="0,16,0,0"
                        Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding SelectedOperation.Title, StringFormat=正在执行：{0}}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" HorizontalAlignment="Right" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />
                        </Grid>
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding ProgressDetail}" Style="{StaticResource CaptionStyle}" Margin="0,7,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <TextBlock Text="已用时间：" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="   预计剩余：" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding RemainingText}" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Background="{DynamicResource ErrorContainerBrush}" BorderBrush="{DynamicResource ErrorBrush}" Margin="0,16,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="任务未完成" Foreground="{DynamicResource ErrorBrush}" FontWeight="SemiBold" FontSize="17" />
                        <TextBlock Text="{Binding ErrorMessage}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Background="{DynamicResource SuccessContainerBrush}" BorderBrush="{DynamicResource SuccessBrush}" Margin="0,16,0,0"
                        Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="转换完成" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" FontSize="17" />
                            <TextBlock Text="{Binding OutputPath}" TextTrimming="CharacterEllipsis" MaxWidth="650" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Content="打开结果" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenOutputCommand}" />
                            <Button Content="显示位置" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RevealOutputCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
