<UserControl x:Class="Shizhen.Windows.Views.ExtractorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Shizhen.Windows.ViewModels"
             xmlns:models="clr-namespace:Shizhen.Windows.Models">
    <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch" Padding="0,0,8,0">
        <Grid MaxWidth="1040" Margin="32,28,32,40" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="公开媒体提取" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="粘贴公开分享链接，提取其中的视频、图片和音频" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource NoticeCardStyle}" Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource PrimaryContainerBrush}" VerticalAlignment="Top">
                        <TextBlock Text="i" FontFamily="Segoe UI" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Margin="11,2,0,0" Text="仅处理无需登录、无 DRM 且你有权保存的公开内容。不会导入 Cookie 或绕过访问限制。" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="分享链接或分享文字" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="程序会提取第一条有效 HTTP / HTTPS 链接" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="从剪贴板粘贴" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PasteCommand}" Margin="12,0,0,0" />
                    </Grid>

                    <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Height="112" VerticalContentAlignment="Top"
                             Margin="0,16,0,0"
                             AutomationProperties.Name="分享链接或分享文字" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="解析链接" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ParseCommand}" MinWidth="132" />
                        <Button Grid.Column="1" Content="清空" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearCommand}" Margin="10,0,0,0" />
                        <Button Grid.Column="3" Content="取消" Style="{StaticResource DangerButtonStyle}" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="识别结果" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Platform}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ExtractedUrl, TargetNullValue=尚未识别链接}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Height="20" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4">
                <Border Style="{StaticResource CardStyle}" Background="{DynamicResource SurfaceSecondaryBrush}" Margin="0,16,0,0"
                        Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" HorizontalAlignment="Right" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />
                        </Grid>
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Margin="0,12,0,0" IsIndeterminate="{Binding IsParsing, Mode=OneWay}" />
                        <TextBlock Text="{Binding ProgressDetail}" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Background="{DynamicResource ErrorContainerBrush}" BorderBrush="{DynamicResource ErrorBrush}" Margin="0,16,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Viewbox Width="24" Height="24" VerticalAlignment="Top">
                            <Path Data="M8,1 L15,15 L1,15 Z M8,5 L8,10 M8,13 L8,13" Stroke="{DynamicResource ErrorBrush}" Fill="Transparent" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Viewbox>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="操作未完成" FontWeight="SemiBold" Foreground="{DynamicResource ErrorBrush}" />
                            <TextBlock Text="{Binding ErrorMessage}" Margin="0,5,0,0" />
                            <TextBlock Text="技术详情已写入诊断日志，不会在此显示完整异常堆栈。" Style="{StaticResource CaptionStyle}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="5" Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource CardStyle}" Background="{DynamicResource SuccessContainerBrush}" BorderBrush="{DynamicResource SuccessBrush}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="解析成功" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock Text="{Binding ResultSummary}" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="96" Height="96" CornerRadius="12" Background="{DynamicResource SurfaceSecondaryBrush}" VerticalAlignment="Top" ClipToBounds="True">
                            <Grid>
                                <Viewbox Width="32" Height="32" Opacity="0.35">
                                    <Path Data="M2,3 L14,3 L14,13 L2,13 Z M4,10 L7,7 L9,9 L11,6 L14,9" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" Fill="Transparent" />
                                </Viewbox>
                                <Image Source="{Binding ParsedMedia.ThumbnailUrl, Converter={StaticResource RemoteImage}}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{Binding ParsedMedia.Title, TargetNullValue=未提供作品标题}" FontSize="17" FontWeight="SemiBold" MaxHeight="50" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ParsedMedia.Author, StringFormat=作者：{0}}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" Visibility="{Binding ParsedMedia.Author, Converter={StaticResource StringToVisibility}}" />
                            <TextBlock Text="{Binding ParsedMedia.Platform, StringFormat=平台：{0}}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            <Expander Header="查看技术详情" Margin="0,9,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{Binding ParsedMedia.SourceUrl}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ParsedMedia.ExtractorName, StringFormat=解析器：{0}}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="可下载资源" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="相同类型的不同清晰度已经合并，请选择后下载" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="保存到：" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DownloadFolder}" MaxWidth="230" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,10,0" />
                        <Button Content="更改位置" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ChooseFolderCommand}" />
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding Groups}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MediaGroupViewModel}">
                            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}" />
                                        <Border Grid.Column="1" Background="{DynamicResource PrimaryContainerBrush}" CornerRadius="8" Padding="9,4">
                                            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Margin="0,12,0,0" BorderThickness="0" Background="Transparent">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="12" />
                                                <Setter Property="Margin" Value="0,0,0,7" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="ResourceBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="ResourceBorder" Property="Background" Value="{DynamicResource PrimaryContainerBrush}" />
                                                                    <Setter TargetName="ResourceBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ResourceBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:MediaItem}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Ellipse Width="12" Height="12" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontWeight="SemiBold">
                                                            <Run Text="{Binding QualityDisplay, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding FormatDisplay, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,4,0,0">
                                                            <Run Text="{Binding ResolutionDisplay, Mode=OneWay}" /><Run Text=" · 大小 " /><Run Text="{Binding SizeDisplay, Mode=OneWay}" /><Run Text=" · 时长 " /><Run Text="{Binding DurationDisplay, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Text="该资源仅为试听片段，不代表完整歌曲。" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,4,0,0"
                                                                   Visibility="{Binding IsPreviewOnly, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding DownloadStatus}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="本地预览" Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Grid.Column="1" Content="{Binding DownloadLabel}" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0"
                                                Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Grid.Row="6" Style="{StaticResource CardStyle}" Background="{DynamicResource SuccessContainerBrush}" BorderBrush="{DynamicResource SuccessBrush}" Margin="0,16,0,0"
                    Visibility="{Binding LastOutputPath, Converter={StaticResource StringToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="下载完成" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" FontSize="17" />
                        <TextBlock Text="{Binding LastOutputPath}" TextTrimming="CharacterEllipsis" MaxWidth="650" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Content="打开文件" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenOutputCommand}" />
                        <Button Content="在文件夹中显示" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RevealOutputCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
