<Window x:Class="Shizhen.Windows.Views.MediaPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拾帧 · 本地预览"
        Width="920" Height="680" MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Icon="../Assets/Shizhen.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="本地预览" Style="{StaticResource PageTitleStyle}" FontSize="22" />
                <TextBlock x:Name="FileTitleText" Style="{StaticResource PageSubtitleStyle}"
                           MaxWidth="720" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource PrimaryContainerBrush}"
                    CornerRadius="9" Padding="11,6" VerticalAlignment="Top">
                <TextBlock Text="本地缓存 · 不打开网页" Foreground="{DynamicResource PrimaryBrush}"
                           FontSize="12" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="0,18,0,16" CornerRadius="14" ClipToBounds="True"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="#081827">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" />
                <MediaElement x:Name="PreviewMedia" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                              Stretch="Uniform" Visibility="Collapsed"
                              MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed" />
                <StackPanel x:Name="AudioPlaceholder" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="88" Height="88" CornerRadius="44" Background="#263F54">
                        <TextBlock Text="♫" FontFamily="Segoe UI Symbol" FontSize="42" Foreground="#7DD8FF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="正在本机播放音频" Foreground="White" FontSize="16"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>
                <TextBlock x:Name="PreviewErrorText" Foreground="#FFFFD2D2" FontSize="15"
                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                           MaxWidth="520" Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="PlaybackControls" Orientation="Horizontal">
                <Button x:Name="PlayPauseButton" Content="暂停" Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnPlayPause" MinWidth="96" />
                <Button Content="从头播放" Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnRestart" Margin="10,0,0,0" />
                <TextBlock Text="音量" VerticalAlignment="Center" Margin="18,0,8,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Slider Width="130" Minimum="0" Maximum="1" Value="0.8"
                        ValueChanged="OnVolumeChanged" VerticalAlignment="Center"
                        AutomationProperties.Name="预览音量" />
            </StackPanel>
            <Button Grid.Column="1" Content="关闭" Style="{StaticResource SecondaryButtonStyle}"
                    Click="OnClose" MinWidth="96" />
        </Grid>
    </Grid>
</Window>
